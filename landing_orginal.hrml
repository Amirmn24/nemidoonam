<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Vyrvona | دستیار هوشمند یادگیری و مدیریت مطالعه</title>
<meta name="description" content="Vyrvona — پلتفرم یکپارچه مطالعه، فلش‌کارت هوشمند با هوش مصنوعی و مرور فاصله‌دار. به‌زودی.">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 140 130'%3E%3Cpath fill='%234f46e5' d='M12 6 H52 C46 10 44 16 46 22 L80 104 L80 122 H58 L20 26 C18 18 16 10 12 6 Z'/%3E%3Cpath fill='%234f46e5' d='M6 18 H17 L56 112 C58 118 55 122 49 122 H47 Z'/%3E%3Cpath stroke='%234f46e5' stroke-width='7' fill='none' d='M124 8 L80 120'/%3E%3Cpath stroke='%234f46e5' stroke-width='4' fill='none' d='M124 8 L113 16 L79 106'/%3E%3C/svg%3E">
<link rel="preload" as="style" href="https://cdn.jsdelivr.net/fontsource/css/vazirmatn@latest/400.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/fontsource/css/vazirmatn@latest/400.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/fontsource/css/vazirmatn@latest/500.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/fontsource/css/vazirmatn@latest/700.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/fontsource/css/vazirmatn@latest/800.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/fontsource/css/space-grotesk@latest/500.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/fontsource/css/space-grotesk@latest/700.css">
<style>
:root{
  --indigo:#4f46e5; --violet:#8b5cf6; --pink:#ec4899;
  --bg:#050514; --bg2:#0a0a20;
  --panel:rgba(255,255,255,.05); --stroke:rgba(255,255,255,.11);
  --text:#eef0ff; --muted:#a7abce; --lite:#818cf8;
  --rad:22px;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:96px;color-scheme:dark}
body{
  font-family:'Vazirmatn',Tahoma,sans-serif;
  background:var(--bg); color:var(--text);
  overflow-x:hidden; line-height:1.9;
}
::selection{background:var(--indigo);color:#fff}
::-webkit-scrollbar{width:10px}
::-webkit-scrollbar-track{background:var(--bg)}
::-webkit-scrollbar-thumb{background:linear-gradient(var(--indigo),var(--violet));border-radius:8px}
.en{font-family:'Space Grotesk',sans-serif;direction:ltr;unicode-bidi:isolate;letter-spacing:.03em}
img,svg{display:block}
a{color:inherit;text-decoration:none}
button{font-family:inherit;cursor:pointer}

/* ---------- ambient background ---------- */
body::before{
  content:""; position:fixed; inset:0; z-index:0; pointer-events:none;
  background-image:linear-gradient(rgba(255,255,255,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.035) 1px,transparent 1px);
  background-size:64px 64px;
  mask-image:radial-gradient(ellipse 90% 70% at 50% 30%, #000 0%, transparent 75%);
  -webkit-mask-image:radial-gradient(ellipse 90% 70% at 50% 30%, #000 0%, transparent 75%);
}
.orb{position:fixed;border-radius:50%;filter:blur(110px);z-index:0;pointer-events:none;opacity:.5}
.orb-a{width:520px;height:520px;background:#4f46e5;top:-160px;right:-140px;animation:orbFloat 14s ease-in-out infinite alternate}
.orb-b{width:460px;height:460px;background:#7c3aed;bottom:-160px;left:-140px;animation:orbFloat 17s ease-in-out infinite alternate-reverse}
@keyframes orbFloat{from{transform:translate(0,0) scale(1)}to{transform:translate(-60px,50px) scale(1.15)}}
#webgl{position:fixed;inset:0;width:100%;height:100%;z-index:1;pointer-events:none}
header,main,footer{position:relative;z-index:2}

/* ---------- navbar ---------- */
header{
  position:fixed;top:0;right:0;left:0;z-index:50;
  transition:background .4s,border-color .4s,backdrop-filter .4s;
  border-bottom:1px solid transparent;
}
header.scrolled{background:rgba(5,5,20,.72);backdrop-filter:blur(16px);border-color:var(--stroke)}
.nav{max-width:1200px;margin:auto;display:flex;align-items:center;gap:28px;padding:18px 24px}
.brand{display:flex;align-items:center;gap:10px;margin-left:auto}
.brand .mark{width:40px;height:37px}
.brand .wordmark{font-family:'Space Grotesk';font-weight:700;font-size:1.35rem;letter-spacing:.02em;color:#fff}
.nav-links{display:flex;gap:26px;align-items:center;font-size:.95rem;font-weight:500;color:var(--muted)}
.nav-links a{position:relative;transition:color .3s}
.nav-links a:hover{color:#fff}
.nav-links a::after{content:"";position:absolute;right:0;bottom:-6px;width:0;height:2px;border-radius:2px;background:linear-gradient(90deg,var(--indigo),var(--violet));transition:width .35s}
.nav-links a:hover::after{width:100%}
.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:10px;
  border:none;border-radius:16px;font-weight:700;font-size:1rem;
  padding:14px 30px;transition:transform .3s,box-shadow .3s,filter .3s;
  position:relative;overflow:hidden;
}
.btn-primary{
  color:#fff;background:linear-gradient(135deg,var(--indigo),var(--violet));
  box-shadow:0 10px 34px -8px rgba(79,70,229,.65), inset 0 1px 0 rgba(255,255,255,.25);
}
.btn-primary:hover{transform:translateY(-3px);box-shadow:0 18px 44px -8px rgba(124,58,237,.75)}
.btn-primary::after{content:"";position:absolute;inset:0;background:linear-gradient(105deg,transparent 40%,rgba(255,255,255,.35) 50%,transparent 60%);transform:translateX(150%);transition:transform .8s}
.btn-primary:hover::after{transform:translateX(-150%)}
.btn-ghost{background:rgba(255,255,255,.06);border:1px solid var(--stroke);color:var(--text);backdrop-filter:blur(8px)}
.btn-ghost:hover{background:rgba(255,255,255,.12);transform:translateY(-3px)}
.btn-sm{padding:10px 22px;font-size:.9rem;border-radius:13px}
#burger{display:none;background:none;border:none;width:42px;height:42px;position:relative}
#burger span{position:absolute;right:9px;left:9px;height:2px;border-radius:2px;background:#fff;transition:.35s}
#burger span:nth-child(1){top:14px}#burger span:nth-child(2){top:20px}#burger span:nth-child(3){top:26px}
header.open #burger span:nth-child(1){top:20px;transform:rotate(45deg)}
header.open #burger span:nth-child(2){opacity:0}
header.open #burger span:nth-child(3){top:20px;transform:rotate(-45deg)}

/* ---------- hero ---------- */
.hero{min-height:100svh;display:flex;align-items:center;padding:140px 24px 80px;max-width:1240px;margin:auto}
.hero-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:56px;align-items:center;width:100%}
.badge{
  display:inline-flex;align-items:center;gap:10px;padding:8px 18px;border-radius:100px;
  background:rgba(79,70,229,.14);border:1px solid rgba(129,140,248,.35);
  color:#c7c9ff;font-size:.85rem;font-weight:500;backdrop-filter:blur(8px);
  animation:badgePulse 3s ease-in-out infinite;
}
.badge .pulse{width:8px;height:8px;border-radius:50%;background:#22d3ee;box-shadow:0 0 0 0 rgba(34,211,238,.6);animation:ping 2s infinite}
@keyframes ping{70%{box-shadow:0 0 0 12px rgba(34,211,238,0)}100%{box-shadow:0 0 0 0 rgba(34,211,238,0)}}
@keyframes badgePulse{0%,100%{transform:translateY(0)}50%{transform:translateY(-4px)}}
.hero h1{
  font-size:clamp(2.3rem,5.6vw,4.3rem);font-weight:800;line-height:1.45;margin:26px 0 10px;
}
.grad{
  background:linear-gradient(100deg,#a5b4fc 0%,#818cf8 30%,#c084fc 65%,#f0abfc 100%);
  -webkit-background-clip:text;background-clip:text;color:transparent;
  background-size:200% 100%;animation:gradShift 6s ease-in-out infinite;
}
@keyframes gradShift{0%,100%{background-position:0% 50%}50%{background-position:100% 50%}}
.hero .en-sub{color:var(--lite);font-size:clamp(.85rem,1.4vw,1.05rem);font-weight:500;margin-bottom:14px;display:block}
.hero p.lead{color:var(--muted);font-size:clamp(.98rem,1.5vw,1.12rem);max-width:56ch;margin-bottom:34px}
.hero-cta{display:flex;gap:16px;flex-wrap:wrap;align-items:center}
.chips{display:flex;gap:10px;flex-wrap:wrap;margin-top:30px}
.chip{padding:7px 16px;border-radius:100px;background:rgba(255,255,255,.06);border:1px solid var(--stroke);font-size:.82rem;color:#d3d5f5;backdrop-filter:blur(6px)}

/* ---------- 3D product mockup ---------- */
.scene3d{perspective:1600px}
.mock{position:relative;transform-style:preserve-3d;transition:transform .5s cubic-bezier(.2,.8,.3,1);animation:mockFloat 7s ease-in-out infinite}
@keyframes mockFloat{0%,100%{translate:0 0}50%{translate:0 -14px}}
.window{
  background:rgba(9,9,28,.82);border:1px solid var(--stroke);border-radius:24px;
  backdrop-filter:blur(18px);overflow:hidden;
  box-shadow:0 40px 90px -20px rgba(0,0,0,.7), 0 0 0 1px rgba(129,140,248,.12), 0 0 80px -20px rgba(79,70,229,.45);
}
.win-bar{display:flex;align-items:center;gap:8px;padding:14px 18px;border-bottom:1px solid var(--stroke);background:rgba(255,255,255,.03)}
.dot{width:11px;height:11px;border-radius:50%}
.dot.r{background:#f87171}.dot.y{background:#fbbf24}.dot.g{background:#34d399}
.win-title{margin-right:10px;color:var(--muted);font-size:.8rem;font-weight:500}
.win-chip{margin-right:auto;font-size:.72rem;color:#a5f3fc;background:rgba(34,211,238,.1);border:1px solid rgba(34,211,238,.3);padding:3px 12px;border-radius:100px}
.win-body{display:grid;grid-template-columns:148px 1fr 168px;min-height:330px}
.win-side{border-left:1px solid var(--stroke);padding:16px 14px;display:flex;flex-direction:column;gap:12px;background:rgba(255,255,255,.02)}
.side-title{font-size:.72rem;color:var(--muted);margin-bottom:2px}
.book{display:flex;align-items:center;gap:9px;padding:8px 10px;border-radius:12px;background:rgba(255,255,255,.04);border:1px solid transparent;transition:.3s;font-size:.75rem}
.book:hover{border-color:rgba(129,140,248,.4);background:rgba(79,70,229,.15)}
.book.active{border-color:rgba(129,140,248,.5);background:rgba(79,70,229,.2)}
.spine{width:8px;height:30px;border-radius:4px;flex-shrink:0}
.win-reader{padding:22px 24px;font-size:.86rem;color:#c9cbe8}
.win-reader h4{color:#fff;font-size:.95rem;margin-bottom:10px}
.win-reader mark{
  background:linear-gradient(120deg,rgba(79,70,229,.55),rgba(139,92,246,.55));
  color:#fff;border-radius:4px;padding:0 5px;position:relative;white-space:nowrap;
}
.hl-tip{
  position:absolute;bottom:calc(100% + 8px);right:50%;transform:translateX(50%);
  background:#fff;color:#312e81;font-size:.68rem;font-weight:700;padding:4px 12px;border-radius:100px;
  white-space:nowrap;box-shadow:0 8px 20px rgba(0,0,0,.4);animation:tipBounce 2.6s ease-in-out infinite;
}
@keyframes tipBounce{0%,100%{translate:0 0}50%{translate:0 -5px}}
.win-notes{border-right:1px solid var(--stroke);padding:16px 14px;display:flex;flex-direction:column;gap:10px;background:rgba(255,255,255,.02)}
.note{background:rgba(250,204,21,.08);border:1px solid rgba(250,204,21,.25);border-radius:12px;padding:9px 11px;font-size:.7rem;color:#fde68a;line-height:1.7}
.note.b{background:rgba(34,211,238,.07);border-color:rgba(34,211,238,.25);color:#a5f3fc}
.win-progress{padding:12px 18px;border-top:1px solid var(--stroke);display:flex;align-items:center;gap:12px;font-size:.72rem;color:var(--muted)}
.pbar{flex:1;height:6px;border-radius:10px;background:rgba(255,255,255,.08);overflow:hidden}
.pbar i{display:block;height:100%;width:0;border-radius:10px;background:linear-gradient(90deg,var(--indigo),#22d3ee);animation:fill 2.2s 1s cubic-bezier(.2,.7,.2,1) forwards}
@keyframes fill{to{width:68%}}
.float-ff{
  position:absolute;top:-38px;left:-30px;width:170px;height:110px;perspective:900px;z-index:3;
  animation:mockFloat 5.5s 1s ease-in-out infinite;
}
.ff-inner{position:relative;width:100%;height:100%;transform-style:preserve-3d;animation:ffFlip 9s cubic-bezier(.4,.1,.2,1) infinite}
@keyframes ffFlip{0%,38%{transform:rotateY(0)}50%,88%{transform:rotateY(180deg)}100%{transform:rotateY(360deg)}}
.ff-face{
  position:absolute;inset:0;backface-visibility:hidden;border-radius:16px;padding:12px 14px;
  display:flex;flex-direction:column;justify-content:center;gap:4px;font-size:.72rem;font-weight:700;text-align:center;
  box-shadow:0 20px 44px -12px rgba(0,0,0,.6);
}
.ff-front{background:linear-gradient(150deg,#eef2ff,#e0e7ff);color:#3730a3;border:1px solid #c7d2fe}
.ff-back{background:linear-gradient(150deg,var(--indigo),var(--violet));color:#fff;transform:rotateY(180deg)}
.ff-face small{font-weight:500;opacity:.75;font-size:.64rem}
.toast{
  position:absolute;bottom:-22px;right:-16px;z-index:3;
  background:rgba(16,185,129,.14);border:1px solid rgba(52,211,153,.45);color:#6ee7b7;
  backdrop-filter:blur(10px);padding:9px 18px;border-radius:100px;font-size:.78rem;font-weight:700;
  animation:mockFloat 6s .5s ease-in-out infinite;box-shadow:0 14px 34px -10px rgba(16,185,129,.4);
}

/* ---------- marquee ---------- */
.marquee{border-block:1px solid var(--stroke);background:rgba(255,255,255,.025);overflow:hidden;padding:16px 0;backdrop-filter:blur(6px)}
.marquee .track{display:flex;gap:44px;width:max-content;animation:scrollX 32s linear infinite}
.marquee:hover .track{animation-play-state:paused}
@keyframes scrollX{from{transform:translateX(0)}to{transform:translateX(-50%)}}
.mq{display:flex;align-items:center;gap:44px;color:#c3c6ea;font-weight:500;font-size:.95rem;white-space:nowrap}
.mq .star{color:var(--lite)}

/* ---------- sections ---------- */
section{padding:110px 24px}
.wrap{max-width:1200px;margin:auto}
.sec-head{text-align:center;margin-bottom:64px}
.overline{color:var(--lite);font-weight:700;font-size:.8rem;letter-spacing:.35em;text-transform:uppercase}
.sec-head h2{font-size:clamp(1.7rem,3.8vw,2.8rem);font-weight:800;margin:14px 0 12px;line-height:1.6}
.sec-head p{color:var(--muted);max-width:64ch;margin:auto}

/* features */
.f-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
.f-card{
  background:linear-gradient(160deg,rgba(255,255,255,.055),rgba(255,255,255,.02));
  border:1px solid var(--stroke);border-radius:var(--rad);padding:32px 28px;
  transition:transform .45s cubic-bezier(.2,.8,.3,1),border-color .4s,box-shadow .4s;
  position:relative;overflow:hidden;will-change:transform;
}
.f-card::before{content:"";position:absolute;inset:0;background:radial-gradient(420px circle at var(--mx,50%) var(--my,0%),rgba(79,70,229,.16),transparent 60%);opacity:0;transition:opacity .4s}
.f-card:hover::before{opacity:1}
.f-card:hover{border-color:rgba(129,140,248,.45);box-shadow:0 24px 60px -18px rgba(79,70,229,.4)}
.f-icon{
  width:56px;height:56px;border-radius:16px;display:grid;place-items:center;margin-bottom:20px;
  background:linear-gradient(135deg,var(--indigo),var(--violet));color:#fff;
  box-shadow:0 12px 28px -8px rgba(79,70,229,.6), inset 0 1px 0 rgba(255,255,255,.3);
  transition:transform .4s;
}
.f-card:hover .f-icon{transform:rotate(-8deg) scale(1.1)}
.f-card h3{font-size:1.15rem;font-weight:800;margin-bottom:10px}
.f-card p{color:var(--muted);font-size:.9rem}
.f-card .en{display:block;margin-top:14px;color:var(--lite);font-size:.72rem;font-weight:500;opacity:.85}

/* how it works */
.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:26px;position:relative}
.step{text-align:center;position:relative;padding:0 8px}
.step:not(:last-child)::after{
  content:"";position:absolute;top:34px;right:calc(50% + 46px);width:calc(100% - 92px);height:2px;
  background:repeating-linear-gradient(90deg,var(--lite) 0 8px,transparent 8px 16px);opacity:.4;
  transform:scaleX(-1);
}
.step-num{
  width:68px;height:68px;margin:0 auto 20px;border-radius:22px;display:grid;place-items:center;
  font-size:1.3rem;font-weight:800;color:#fff;
  background:linear-gradient(150deg,rgba(79,70,229,.35),rgba(139,92,246,.15));
  border:1px solid rgba(129,140,248,.45);backdrop-filter:blur(8px);
  box-shadow:0 14px 34px -10px rgba(79,70,229,.5);transition:transform .4s;
}
.step:hover .step-num{transform:translateY(-6px) rotate(6deg)}
.step h3{font-size:1.05rem;font-weight:800;margin-bottom:8px}
.step p{color:var(--muted);font-size:.86rem}
.step .en{display:block;margin-top:8px;color:var(--lite);font-size:.7rem}

/* SRS demo */
.srs-panel{
  border-radius:32px;padding:64px 40px;position:relative;overflow:hidden;
  background:linear-gradient(160deg,rgba(79,70,229,.14),rgba(10,10,32,.6));
  border:1px solid rgba(129,140,248,.25);backdrop-filter:blur(12px);
}
.srs-grid{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center}
.demo-card{width:min(430px,100%);aspect-ratio:16/10.5;perspective:1400px;cursor:pointer;margin:auto}
.demo-inner{position:relative;width:100%;height:100%;transform-style:preserve-3d;transition:transform .9s cubic-bezier(.25,.8,.25,1)}
.demo-card.flipped .demo-inner{transform:rotateY(180deg)}
.demo-face{
  position:absolute;inset:0;backface-visibility:hidden;border-radius:24px;padding:28px;
  display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;text-align:center;
}
.demo-front{
  background:rgba(255,255,255,.06);border:1px solid var(--stroke);backdrop-filter:blur(10px);
  box-shadow:0 30px 70px -20px rgba(0,0,0,.6);
}
.demo-front .q-ico{font-size:2.6rem;line-height:1}
.demo-front h4{font-size:1.1rem;font-weight:800}
.demo-front small{color:var(--muted)}
.demo-back{
  background:linear-gradient(150deg,var(--indigo),var(--violet));transform:rotateY(180deg);
  box-shadow:0 30px 70px -20px rgba(79,70,229,.6);
}
.demo-back h4{font-size:1.05rem;font-weight:800}
.demo-back small{opacity:.85}
.rate-row{display:flex;gap:12px;justify-content:center;margin-top:26px;flex-wrap:wrap}
.rate{
  border-radius:13px;padding:10px 24px;font-weight:700;font-size:.9rem;border:1px solid var(--stroke);
  background:rgba(255,255,255,.05);color:var(--text);transition:.3s;
}
.rate:hover{transform:translateY(-3px)}
.rate.hard:hover{border-color:#f87171;color:#fca5a5;background:rgba(248,113,113,.1)}
.rate.good:hover{border-color:#fbbf24;color:#fcd34d;background:rgba(251,191,36,.1)}
.rate.easy:hover{border-color:#34d399;color:#6ee7b7;background:rgba(52,211,153,.1)}
#nextReview{
  margin-top:18px;text-align:center;color:#a5f3fc;font-weight:700;font-size:.92rem;min-height:28px;
  background:rgba(34,211,238,.08);border:1px dashed rgba(34,211,238,.4);border-radius:100px;
  padding:4px 20px;display:inline-block;
}
.pop{animation:pop .5s cubic-bezier(.2,.9,.3,1.4)}
@keyframes pop{0%{transform:scale(.7)}60%{transform:scale(1.08)}100%{transform:scale(1)}}
.srs-line{display:flex;justify-content:space-between;position:relative;margin-top:56px;padding:0 8px}
.srs-line::before{content:"";position:absolute;top:9px;right:12px;left:12px;height:3px;border-radius:3px;background:linear-gradient(90deg,var(--indigo),var(--violet),var(--pink))}
.srs-dot{position:relative;display:flex;flex-direction:column;align-items:center;gap:10px}
.srs-dot i{width:20px;height:20px;border-radius:50%;background:#0a0a20;border:3px solid var(--lite);position:relative;z-index:1;animation:dotPulse 3s ease-in-out infinite}
.srs-dot:nth-child(2) i{animation-delay:.4s;border-color:#a78bfa}
.srs-dot:nth-child(3) i{animation-delay:.8s;border-color:#c084fc}
.srs-dot:nth-child(4) i{animation-delay:1.2s;border-color:#e879f9}
.srs-dot:nth-child(5) i{animation-delay:1.6s;border-color:#f472b6}
@keyframes dotPulse{0%,100%{box-shadow:0 0 0 0 rgba(129,140,248,.5)}50%{box-shadow:0 0 0 9px rgba(129,140,248,0)}}
.srs-dot span{font-size:.8rem;color:var(--muted);font-weight:700}

/* FAQ */
.faq{max-width:780px;margin:auto;display:flex;flex-direction:column;gap:14px}
.faq-item{border:1px solid var(--stroke);border-radius:18px;background:rgba(255,255,255,.03);overflow:hidden;transition:border-color .3s}
.faq-item.open{border-color:rgba(129,140,248,.5)}
.faq-q{width:100%;display:flex;justify-content:space-between;align-items:center;gap:16px;background:none;border:none;color:var(--text);font-size:1rem;font-weight:700;padding:20px 24px;text-align:right}
.faq-q .arr{transition:transform .4s;color:var(--lite);flex-shrink:0}
.faq-item.open .arr{transform:rotate(180deg)}
.faq-a{max-height:0;overflow:hidden;transition:max-height .5s cubic-bezier(.2,.7,.2,1)}
.faq-a p{padding:0 24px 22px;color:var(--muted);font-size:.92rem}

/* waitlist */
.wl-panel{
  max-width:860px;margin:auto;border-radius:32px;padding:70px 44px;text-align:center;position:relative;overflow:hidden;
  border:1.5px solid transparent;
  background:linear-gradient(#0b0b24,#0b0b24) padding-box, linear-gradient(135deg,var(--indigo),var(--violet),var(--pink)) border-box;
  box-shadow:0 50px 120px -30px rgba(79,70,229,.45);
}
.wl-panel::before{content:"";position:absolute;inset:-40%;background:conic-gradient(from 0deg,transparent 0 70%,rgba(129,140,248,.14) 78%,transparent 86%);animation:spin 9s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
.wl-panel>*{position:relative}
.wl-panel h2{font-size:clamp(1.6rem,3.4vw,2.5rem);font-weight:800;margin:14px 0 12px;line-height:1.6}
.wl-panel p{color:var(--muted);max-width:56ch;margin:0 auto 36px}
#wlForm{display:flex;gap:14px;max-width:560px;margin:auto;flex-wrap:wrap;justify-content:center}
#wlForm.shake{animation:shake .5s}
@keyframes shake{0%,100%{transform:translateX(0)}20%{transform:translateX(-9px)}40%{transform:translateX(9px)}60%{transform:translateX(-6px)}80%{transform:translateX(6px)}}
#email{
  flex:1;min-width:250px;direction:ltr;text-align:left;
  background:rgba(255,255,255,.06);border:1px solid var(--stroke);border-radius:16px;
  padding:15px 22px;color:#fff;font-family:'Space Grotesk';font-size:.95rem;outline:none;transition:.3s;
}
#email::placeholder{color:#6d70a0}
#email:focus{border-color:var(--lite);box-shadow:0 0 0 4px rgba(79,70,229,.25)}
#formMsg{width:100%;color:#fca5a5;font-size:.85rem;min-height:22px}
.wl-note{margin-top:26px;font-size:.8rem;color:#8a8db4}
#wlSuccess{display:none;flex-direction:column;align-items:center;gap:18px}
#wlSuccess.show{display:flex;animation:pop .6s cubic-bezier(.2,.9,.3,1.3)}
#wlSuccess svg{width:84px;height:84px}
#wlSuccess circle{stroke:var(--lite);stroke-width:2.5;stroke-dasharray:151;stroke-dashoffset:151;animation:draw 1s .1s ease forwards}
#wlSuccess path{stroke:#34d399;stroke-width:4;stroke-linecap:round;stroke-linejoin:round;stroke-dasharray:40;stroke-dashoffset:40;animation:draw .7s .8s ease forwards}
@keyframes draw{to{stroke-dashoffset:0}}
#wlSuccess h3{font-size:1.3rem;font-weight:800}
#wlSuccess p{margin:0}

/* footer */
footer{border-top:1px solid var(--stroke);padding:44px 24px;background:rgba(5,5,20,.6);backdrop-filter:blur(10px)}
.foot{max-width:1200px;margin:auto;display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap}
.foot .brand .wordmark{font-size:1.1rem}
.foot p{color:var(--muted);font-size:.85rem}
.foot .en{color:#767aa8;font-size:.75rem}

/* reveal */
.reveal{opacity:0;transform:translateY(34px);transition:opacity .9s ease,transform .9s cubic-bezier(.2,.7,.2,1);transition-delay:var(--d,0s)}
.reveal.in{opacity:1;transform:none}

/* responsive */
@media(max-width:1024px){
  .hero-grid{grid-template-columns:1fr;gap:70px}
  .f-grid{grid-template-columns:repeat(2,1fr)}
  .steps{grid-template-columns:repeat(2,1fr);gap:44px}
  .step:not(:last-child)::after{display:none}
  .srs-grid{grid-template-columns:1fr;gap:40px}
  .float-ff{left:-8px;top:-30px}
}
@media(max-width:820px){
  .nav-links{
    position:fixed;top:76px;right:16px;left:16px;flex-direction:column;background:rgba(8,8,26,.92);
    backdrop-filter:blur(20px);border:1px solid var(--stroke);border-radius:20px;padding:26px;gap:20px;
    opacity:0;pointer-events:none;transform:translateY(-14px);transition:.4s;
  }
  header.open .nav-links{opacity:1;pointer-events:auto;transform:none}
  #burger{display:block}
  .win-notes{display:none}
  .win-body{grid-template-columns:120px 1fr}
}
@media(max-width:640px){
  section{padding:80px 18px}
  .f-grid{grid-template-columns:1fr}
  .steps{grid-template-columns:1fr}
  .win-side{display:none}
  .win-body{grid-template-columns:1fr}
  .float-ff{width:140px;height:92px;top:-26px;left:-6px}
  .srs-line{overflow-x:auto;padding-bottom:8px}
  .wl-panel{padding:52px 24px}
  .hero{padding-top:120px}
}
@media(prefers-reduced-motion:reduce){
  *,*::before,*::after{animation-duration:.01ms !important;animation-iteration-count:1 !important;transition-duration:.2s !important}
}
</style>
</head>
<body>

<!-- لوگو -->
<svg style="position:absolute;width:0;height:0" aria-hidden="true">
  <symbol id="logoMark" viewBox="0 0 140 130">
    <defs>
      <linearGradient id="lgm" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#a5b4fc"/><stop offset="1" stop-color="#4f46e5"/>
      </linearGradient>
    </defs>
    <path fill="url(#lgm)" d="M12 6 H52 C46 10 44 16 46 22 L80 104 L80 122 H58 L20 26 C18 18 16 10 12 6 Z"/>
    <path fill="url(#lgm)" d="M6 18 H17 L56 112 C58 118 55 122 49 122 H47 Z"/>
    <g stroke="url(#lgm)" fill="none" stroke-linecap="round">
      <path d="M124 8 L80 120" stroke-width="7"/>
      <path d="M124 8 L113 16 L79 106" stroke-width="4"/>
      <path d="M88 34 C96 16 108 8 122 6" stroke-width="5"/>
      <path d="M95 40 C103 26 112 18 124 16" stroke-width="2.5"/>
    </g>
    <path fill="url(#lgm)" d="M52 12 C70 18 80 34 80 60 C80 70 78 78 75 84 C76 56 68 34 50 20 Z"/>
  </symbol>
</svg>

<div class="orb orb-a"></div>
<div class="orb orb-b"></div>
<canvas id="webgl"></canvas>

<header id="navbar">
  <div class="nav">
    <a class="brand" href="#home">
      <svg class="mark"><use href="#logoMark"/></svg>
      <span class="wordmark">Vyrvona</span>
    </a>
    <nav class="nav-links" id="navLinks">
      <a href="#features">امکانات</a>
      <a href="#how">چطور کار می‌کند</a>
      <a href="#srs">مرور فاصله‌دار</a>
      <a href="#faq">سوالات</a>
    </nav>
    <a href="#waitlist" class="btn btn-primary btn-sm" style="margin-right:16px">عضویت در لیست انتظار</a>
    <button id="burger" aria-label="منو"><span></span><span></span><span></span></button>
  </div>
</header>

<main>
<!-- ============ HERO ============ -->
<section class="hero" id="home">
  <div class="hero-grid">
    <div>
      <span class="badge"><span class="pulse"></span> نسخه بتا به‌زودی — <span class="en" style="font-size:.75rem">Beta launching soon</span></span>
      <h1>هوشمندانه بخوان،<br><span class="grad">برای همیشه</span> به خاطر بسپار</h1>
      <span class="en en-sub">Vyrvona — Your all-in-one AI study companion</span>
      <p class="lead">
        Vyrvona یک دستیار هوشمند و یکپارچه برای یادگیری و مدیریت مطالعه است؛ از جمع‌آوری و استریم منابع درسی تا یادداشت‌نویسی تعاملی، فلش‌کارت‌های خودکار با هوش مصنوعی و مرور فاصله‌دار — تا مفاهیم عمیق و پایدار در ذهنت تثبیت شوند.
      </p>
      <div class="hero-cta">
        <a href="#waitlist" class="btn btn-primary">🚀 عضویت در لیست انتظار</a>
        <a href="#features" class="btn btn-ghost">کشف امکانات</a>
      </div>
      <div class="chips">
        <span class="chip">✨ فلش‌کارت هوشمند</span>
        <span class="chip">🔁 مرور فاصله‌دار</span>
        <span class="chip">⏰ یادآور هوشمند</span>
        <span class="chip">📚 کتابخانه دیجیتال</span>
      </div>
    </div>

    <div class="scene3d reveal" style="--d:.2s">
      <div class="mock" id="mock">
        <div class="float-ff" aria-hidden="true">
          <div class="ff-inner">
            <div class="ff-face ff-front">مرور فاصله‌دار چیست؟<small>برای دیدن پاسخ کلیک کن</small></div>
            <div class="ff-face ff-back">مرور در فواصل فزاینده، دقیقاً قبل از فراموشی<small>تثبیت در حافظه بلندمدت</small></div>
          </div>
        </div>
        <div class="window">
          <div class="win-bar">
            <span class="dot r"></span><span class="dot y"></span><span class="dot g"></span>
            <span class="win-title en">Vyrvona Reader — فصل ۳</span>
            <span class="win-chip">چالش امروز: ۲۵ دقیقه</span>
          </div>
          <div class="win-body">
            <aside class="win-side">
              <span class="side-title">کتابخانه من</span>
              <div class="book active"><span class="spine" style="background:linear-gradient(#818cf8,#4f46e5)"></span> روان‌شناسی یادگیری</div>
              <div class="book"><span class="spine" style="background:linear-gradient(#f0abfc,#a855f7)"></span> علوم اعصاب</div>
              <div class="book"><span class="spine" style="background:linear-gradient(#67e8f9,#0891b2)"></span> روش مطالعه</div>
              <div class="book"><span class="spine" style="background:linear-gradient(#fcd34d,#d97706)"></span> ریاضی عمومی ۱</div>
            </aside>
            <div class="win-reader">
              <h4>یادگیری فعال و حافظه بلندمدت</h4>
              <p>
                وقتی اطلاعات درست پیش از آنکه فراموش شوند مرور می‌شوند، مغز ناچار به بازسازی حافظه می‌شود؛ همین تلاشِ بازیابی، مسیرهای عصبی را تقویت می‌کند و باعث
                <mark>یادگیری عمیق و پایدار<span class="hl-tip">✨ ساخت فلش‌کارت</span></mark>
                می‌شود. یادگیرندگان فعال به‌جای بازخوانی منفعلانه، مدام از خودشان آزمون می‌گیرند.
              </p>
            </div>
            <aside class="win-notes">
              <span class="side-title">یادداشت‌های من</span>
              <div class="note">💡 نکته کلیدی: مرور اول باید داخل ۲۴ ساعت باشد.</div>
              <div class="note b">✍️ به‌جای دوباره‌خوانی، از خودت تست بگیر!</div>
            </aside>
          </div>
          <div class="win-progress">
            <span>پیشرفت چالش</span>
            <div class="pbar"><i></i></div>
            <span>۶۸٪</span>
          </div>
        </div>
        <div class="toast">✓ فلش‌کارت به صف مرور اضافه شد</div>
      </div>
    </div>
  </div>
</section>

<!-- ============ MARQUEE ============ -->
<div class="marquee" dir="ltr" aria-hidden="true">
  <div class="track">
    <div class="mq">
      <span>فلش‌کارت هوشمند <span class="en">AI Flashcards</span></span><span class="star">✦</span>
      <span>مرور فاصله‌دار <span class="en">Spaced Repetition</span></span><span class="star">✦</span>
      <span>یادآور هوشمند <span class="en">Smart Reminders</span></span><span class="star">✦</span>
      <span>چالش مطالعاتی <span class="en">Study Challenges</span></span><span class="star">✦</span>
      <span>یادداشت تعاملی <span class="en">Interactive Notes</span></span><span class="star">✦</span>
      <span>کتابخانه دیجیتال <span class="en">Digital Library</span></span><span class="star">✦</span>
    </div>
    <div class="mq">
      <span>فلش‌کارت هوشمند <span class="en">AI Flashcards</span></span><span class="star">✦</span>
      <span>مرور فاصله‌دار <span class="en">Spaced Repetition</span></span><span class="star">✦</span>
      <span>یادآور هوشمند <span class="en">Smart Reminders</span></span><span class="star">✦</span>
      <span>چالش مطالعاتی <span class="en">Study Challenges</span></span><span class="star">✦</span>
      <span>یادداشت تعاملی <span class="en">Interactive Notes</span></span><span class="star">✦</span>
      <span>کتابخانه دیجیتال <span class="en">Digital Library</span></span><span class="star">✦</span>
    </div>
  </div>
</div>

<!-- ============ FEATURES ============ -->
<section id="features">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="overline en">All-in-one platform</span>
      <h2>هر آنچه یک یادگیرنده جدی نیاز دارد</h2>
      <p>همه ابزارهای مطالعه عمیق، در یک محیط یکپارچه و هوشمند — بدون پرش بین ده اپلیکیشن مختلف.</p>
    </div>
    <div class="f-grid">
      <article class="f-card reveal" data-tilt style="--d:.05s">
        <div class="f-icon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 4h6a4 4 0 0 1 4 4v12a3 3 0 0 0-3-3H2z"/><path d="M22 4h-6a4 4 0 0 0-4 4v12a3 3 0 0 1 3-3h7z"/></svg></div>
        <h3>کتابخانه دیجیتال و استریم منابع</h3>
        <p>همه کتب و منابع درسی‌ات را یک‌جا جمع کن، استریم کن و در محیطی آرام و متمرکز مطالعه کن.</p>
        <span class="en">Collect, stream & study your textbooks in one digital space.</span>
      </article>
      <article class="f-card reveal" data-tilt style="--d:.12s">
        <div class="f-icon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"/><path d="M19 15l.9 2.4L22 18.3l-2.1.9L19 21.5l-.9-2.3-2.1-.9 2.1-.9z"/></svg></div>
        <h3>فلش‌کارت خودکار با هوش مصنوعی</h3>
        <p>متن را انتخاب کن؛ هوش مصنوعی به‌صورت خودکار آن را به فلش‌کارت‌های استاندارد تبدیل می‌کند.</p>
        <span class="en">Highlight text; AI crafts standard flashcards instantly.</span>
      </article>
      <article class="f-card reveal" data-tilt style="--d:.19s">
        <div class="f-icon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 1l4 4-4 4"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><path d="M7 23l-4-4 4-4"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg></div>
        <h3>مرور فاصله‌دار (Spaced Repetition)</h3>
        <p>زمان‌بندی هوشمند مرور، دقیقاً پیش از فراموشی — برای تثبیت عمیق و پایدار مفاهیم در ذهن.</p>
        <span class="en">Spaced repetition for deep, lasting memory.</span>
      </article>
      <article class="f-card reveal" data-tilt style="--d:.05s">
        <div class="f-icon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="13" r="8"/><path d="M12 9v4l2.5 2.5"/><path d="M9 2h6"/></svg></div>
        <h3>چالش‌های مطالعاتی زمان‌دار</h3>
        <p>اسپرینت‌های مطالعه متمرکز با هدف مشخص — برای شکستن تنبلی و ساختن عادت‌های پایدار.</p>
        <span class="en">Timed study challenges to beat procrastination.</span>
      </article>
      <article class="f-card reveal" data-tilt style="--d:.12s">
        <div class="f-icon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg></div>
        <h3>یادآورهای هوشمند</h3>
        <p>تلنگرهای به‌موقع و شخصی‌سازی‌شده، درست زمانی که لازم است — تا زنجیره مطالعه‌ات هرگز قطع نشود.</p>
        <span class="en">Smart nudges that keep your streak alive.</span>
      </article>
      <article class="f-card reveal" data-tilt style="--d:.19s">
        <div class="f-icon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg></div>
        <h3>یادداشت‌نویسی تعاملی</h3>
        <p>حاشیه‌نویسی و یادداشت‌برداری داخل متن؛ یادداشت‌هایت را سازمان‌دهی کن و به کارت مرور تبدیلشان کن.</p>
        <span class="en">Interactive note-taking inside your reader.</span>
      </article>
    </div>
  </div>
</section>

<!-- ============ HOW ============ -->
<section id="how">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="overline en">How it works</span>
      <h2>مسیر یادگیری، در چهار گام ساده</h2>
      <p>از منبع تا حافظه بلندمدت — یک جریان پیوسته و بدون اصطکاک.</p>
    </div>
    <div class="steps">
      <div class="step reveal" style="--d:.05s">
        <div class="step-num">۰۱</div>
        <h3>جمع‌آوری کن</h3>
        <p>کتب و منابع درسی‌ات را وارد کتابخانه دیجیتال خودت کن.</p>
        <span class="en">Import your sources</span>
      </div>
      <div class="step reveal" style="--d:.15s">
        <div class="step-num">۰۲</div>
        <h3>بخوان و هایلایت کن</h3>
        <p>با تمرکز کامل مطالعه کن و نکات کلیدی را نشانه‌گذاری کن.</p>
        <span class="en">Read & highlight</span>
      </div>
      <div class="step reveal" style="--d:.25s">
        <div class="step-num">۰۳</div>
        <h3>کارت بساز</h3>
        <p>هوش مصنوعی از هایلایت‌هایت فلش‌کارت استاندارد می‌سازد.</p>
        <span class="en">AI crafts flashcards</span>
      </div>
      <div class="step reveal" style="--d:.35s">
        <div class="step-num">۰۴</div>
        <h3>مرور کن و تثبیت کن</h3>
        <p>با مرور فاصله‌دار، مفاهیم را به حافظه بلندمدت بسپار.</p>
        <span class="en">Review & retain</span>
      </div>
    </div>
  </div>
</section>

<!-- ============ SRS DEMO ============ -->
<section id="srs">
  <div class="wrap">
    <div class="srs-panel reveal">
      <div class="sec-head" style="margin-bottom:44px">
        <span class="overline en">Try it — Spaced Repetition</span>
        <h2>علمِ حافظه پایدار را همین حالا امتحان کن</h2>
        <p>روی کارت کلیک کن تا بچرخد؛ بعد کیفیت مرور را bewerten کن و ببین Vyrvona مرور بعدی را چگونه زمان‌بندی می‌کند.</p>
      </div>
      <div class="srs-grid">
        <div>
          <div class="demo-card" id="demoCard" role="button" aria-label="فلش‌کارت نمونه">
            <div class="demo-inner">
              <div class="demo-face demo-front">
                <span class="q-ico">❓</span>
                <h4>در سیستم مرور فاصله‌دار، هر مفهوم چه زمانی مرور می‌شود؟</h4>
                <small>برای دیدن پاسخ کلیک کن</small>
              </div>
              <div class="demo-face demo-back">
                <span class="q-ico">💡</span>
                <h4>در فواصل فزاینده — دقیقاً پیش از آنکه فراموش شود.</h4>
                <small>این یعنی تثبیت عمیق با کمترین زمان مرور</small>
              </div>
            </div>
          </div>
          <div class="rate-row">
            <button class="rate hard" data-rate="hard">سخت 😓</button>
            <button class="rate good" data-rate="good">خوب 🙂</button>
            <button class="rate easy" data-rate="easy">آسان 😎</button>
          </div>
          <div style="text-align:center"><span id="nextReview"></span></div>
        </div>
        <div>
          <h3 style="font-size:1.25rem;font-weight:800;margin-bottom:14px">منحنی فراموشی را شکست بده</h3>
          <p style="color:var(--muted);font-size:.95rem;margin-bottom:8px">
            مغز انسان طبق «منحنی فراموشی ابینگهاوس» عمل می‌کند: بدون مرور، بیشتر آموخته‌ها در چند روز محو می‌شوند. Vyrvona با زمان‌بندی فزاینده مرور، دقیقاً در لحظه مناسب یادآوری می‌کند — تا هر مفهوم با کمترین تکرار، برای همیشه در حافظه بلندمدت بماند.
          </p>
          <span class="en" style="color:var(--lite);font-size:.78rem">Beat the forgetting curve — review at expanding intervals.</span>
        </div>
      </div>
      <div class="srs-line" aria-hidden="true">
        <div class="srs-dot"><i></i><span>امروز</span></div>
        <div class="srs-dot"><i></i><span>۱ روز</span></div>
        <div class="srs-dot"><i></i><span>۳ روز</span></div>
        <div class="srs-dot"><i></i><span>۷ روز</span></div>
        <div class="srs-dot"><i></i><span>۲۱ روز</span></div>
        <div class="srs-dot"><i></i><span>۳۵ روز</span></div>
      </div>
    </div>
  </div>
</section>

<!-- ============ FAQ ============ -->
<section id="faq">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="overline en">FAQ</span>
      <h2>پرسش‌های پرتکرار</h2>
    </div>
    <div class="faq reveal">
      <div class="faq-item">
        <button class="faq-q">Vyrvona چه زمانی راه‌اندازی می‌شود؟ <span class="arr">▾</span></button>
        <div class="faq-a"><p>توسعه محصول در مرحله نهایی است. اعضای لیست انتظار، اولین کسانی خواهند بود که به نسخه بتا و دسترسی زودهنگام دعوت می‌شوند.</p></div>
      </div>
      <div class="faq-item">
        <button class="faq-q">آیا Vyrvona رایگان خواهد بود؟ <span class="arr">▾</span></button>
        <div class="faq-a"><p>بله، یک سطح رایگان برای همیشه در دسترس خواهد بود؛ اعضای لیست انتظار همچنین تخفیف ویژه سطح حرفه‌ای را در زمان راه‌اندازی دریافت می‌کنند.</p></div>
      </div>
      <div class="faq-item">
        <button class="faq-q">با یادداشت‌ها و منابع من چه اتفاقی می‌افتد؟ <span class="arr">▾</span></button>
        <div class="faq-a"><p>تمام یادداشت‌ها و منابع شما خصوصی و رمزنگاری‌شده باقی می‌مانند؛ هرگز به شخص ثالث فروخته یا منتقل نمی‌شوند. مالکیت داده‌ها فقط مال شماست.</p></div>
      </div>
      <div class="faq-item">
        <button class="faq-q">کدام دستگاه‌ها پشتیبانی می‌شوند؟ <span class="arr">▾</span></button>
        <div class="faq-a"><p>در ابتدا نسخه وب روی همه مرورگرها؛ سپس اپلیکیشن‌های موبایل و دسکتاپ با همگام‌سازی کامل پیشرفت مطالعه‌تان.</p></div>
      </div>
    </div>
  </div>
</section>

<!-- ============ WAITLIST ============ -->
<section id="waitlist">
  <div class="wl-panel reveal">
    <span class="overline en">Join the waitlist</span>
    <h2>جزو اولین‌هایی باش که <span class="grad">Vyrvona</span> را تجربه می‌کنند</h2>
    <p>ما هنوز راه‌اندازی نشده‌ایم؛ ایمیل خودت را ثبت کن تا به‌محض باز شدن دسترسی زودهنگام، اولین نفری باش که خبرش را می‌گیرد. بدون اسپم — فقط یک ایمیل در زمان لانچ.</p>
    <form id="wlForm" novalidate>
      <input type="email" id="email" placeholder="you@example.com" autocomplete="email" required>
      <button type="submit" class="btn btn-primary">ثبت ایمیل ✉️</button>
      <span id="formMsg"></span>
    </form>
    <div id="wlSuccess">
      <svg viewBox="0 0 52 52" fill="none"><circle cx="26" cy="26" r="24"/><path d="M14 27l8 8 16-16"/></svg>
      <h3>عالی! در لیست انتظار هستی 🎉</h3>
      <p>به‌محض راه‌اندازی نسخه بتا، از طریق ایمیل بهت خبر می‌دهیم.</p>
    </div>
    <p class="wl-note">ما عددسازی نمی‌کنیم؛ هنوز اول مسیریم — فقط قول یک تجربه مطالعه بهتر می‌دهیم. 💜</p>
  </div>
</section>
</main>

<footer>
  <div class="foot">
    <a class="brand" href="#home">
      <svg class="mark" style="width:32px;height:30px"><use href="#logoMark"/></svg>
      <span class="wordmark">Vyrvona</span>
    </a>
    <p>ساخته‌شده با 💜 برای ذهن‌های کنجکاو — <span class="en">Crafted for curious minds.</span></p>
    <p>© ۲۰۲۵ Vyrvona — <span class="en">All rights reserved.</span></p>
  </div>
</footer>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
/* ================= THREE.JS SCENE ================= */
(function(){
  if(!window.THREE) return;
  var canvas=document.getElementById('webgl');
  var renderer=new THREE.WebGLRenderer({canvas:canvas,alpha:true,antialias:true});
  renderer.setPixelRatio(Math.min(window.devicePixelRatio,2));
  renderer.setSize(innerWidth,innerHeight,false);
  var scene=new THREE.Scene();
  var camera=new THREE.PerspectiveCamera(50,innerWidth/innerHeight,.1,120);
  camera.position.set(0,.6,15);
  var root=new THREE.Group(); scene.add(root);

  scene.add(new THREE.AmbientLight(0x9aa0ff,.55));
  var pl1=new THREE.PointLight(0x4f46e5,1.3); pl1.position.set(6,6,8); scene.add(pl1);
  var pl2=new THREE.PointLight(0x8b5cf6,1.0); pl2.position.set(-7,-4,6); scene.add(pl2);

  /* کتاب سه‌بعدی باز — الهام‌گرفته از لوگو */
  var book=new THREE.Group(); book.position.y=-.3; root.add(book);
  var coverMat=new THREE.MeshStandardMaterial({color:0x4f46e5,roughness:.35,metalness:.3});
  var pageMat=new THREE.MeshStandardMaterial({color:0xe6e7ff,roughness:.55,metalness:0,side:THREE.DoubleSide});
  function makeCover(side){
    var g=new THREE.Group();
    var m=new THREE.Mesh(new THREE.BoxGeometry(4.8,6.4,.14),coverMat);
    m.position.x=side*2.4; g.add(m);
    var p=new THREE.Mesh(new THREE.PlaneGeometry(4.5,6.1),pageMat);
    p.position.set(side*2.4,0,.11); g.add(p);
    g.rotation.y=side*0.55;
    return g;
  }
  book.add(makeCover(-1)); book.add(makeCover(1));
  var spine=new THREE.Mesh(new THREE.BoxGeometry(.3,6.4,.3),coverMat); book.add(spine);

  var flipGeo=new THREE.PlaneGeometry(4.5,6.1); flipGeo.translate(2.25,0,0);
  var flips=[];
  for(var i=0;i<2;i++){
    var fm=pageMat.clone(); fm.transparent=true; fm.opacity=.92;
    var f=new THREE.Mesh(flipGeo,fm);
    f.position.z=.16+i*.03;
    book.add(f); flips.push(f);
  }

  /* کریستال‌های شناور */
  var crys=[], cg=new THREE.OctahedronGeometry(.5);
  for(var c=0;c<10;c++){
    var cm=new THREE.Mesh(cg,new THREE.MeshStandardMaterial({color:(c%2?0x8b5cf6:0x6366f1),roughness:.3,metalness:.5,transparent:true,opacity:.85}));
    var r=7+Math.random()*4, a=Math.random()*Math.PI*2;
    cm.position.set(Math.cos(a)*r,(Math.random()-.5)*8,Math.sin(a)*r-2);
    cm.scale.setScalar(.4+Math.random()*1.1);
    root.add(cm); crys.push(cm);
  }

  /* ذرات چرخان */
  var N=700, pos=new Float32Array(N*3);
  for(var k=0;k<N;k++){
    var rr=5+Math.random()*7, aa=Math.random()*Math.PI*2;
    pos[k*3]=Math.cos(aa)*rr; pos[k*3+1]=(Math.random()-.5)*10; pos[k*3+2]=Math.sin(aa)*rr;
  }
  var pg=new THREE.BufferGeometry();
  pg.setAttribute('position',new THREE.BufferAttribute(pos,3));
  var pts=new THREE.Points(pg,new THREE.PointsMaterial({color:0x8f94ff,size:.07,transparent:true,opacity:.75,blending:THREE.AdditiveBlending,depthWrite:false}));
  root.add(pts);

  /* حلقه‌های مداری */
  var ring1=new THREE.Mesh(new THREE.TorusGeometry(7.4,.02,8,140),new THREE.MeshBasicMaterial({color:0x4f46e5,transparent:true,opacity:.5}));
  ring1.rotation.x=1.25; root.add(ring1);
  var ring2=new THREE.Mesh(new THREE.TorusGeometry(8.6,.015,8,140),new THREE.MeshBasicMaterial({color:0x8b5cf6,transparent:true,opacity:.35}));
  ring2.rotation.x=1.9; ring2.rotation.y=.6; root.add(ring2);

  /* هاله نور */
  function glowTex(){
    var cv=document.createElement('canvas'); cv.width=cv.height=256;
    var x=cv.getContext('2d');
    var g=x.createRadialGradient(128,128,0,128,128,128);
    g.addColorStop(0,'rgba(130,130,255,.85)');
    g.addColorStop(.4,'rgba(90,80,240,.3)');
    g.addColorStop(1,'rgba(0,0,0,0)');
    x.fillStyle=g; x.fillRect(0,0,256,256);
    return new THREE.CanvasTexture(cv);
  }
  var glow=new THREE.Sprite(new THREE.SpriteMaterial({map:glowTex(),blending:THREE.AdditiveBlending,depthWrite:false,transparent:true}));
  glow.scale.set(17,17,1); root.add(glow);

  var mx=0,my=0;
  addEventListener('mousemove',function(e){mx=e.clientX/innerWidth-.5;my=e.clientY/innerHeight-.5;});
  function layout(){
    if(innerWidth<820){book.scale.setScalar(.72);}else{book.scale.setScalar(1);}
  }
  layout();
  var clock=new THREE.Clock();
  (function tick(){
    var t=clock.getElapsedTime();
    book.rotation.y=Math.sin(t*.22)*.25+mx*.35;
    book.rotation.x=my*.18+Math.sin(t*.5)*.03;
    for(var q=0;q<flips.length;q++){
      flips[q].rotation.y=.55+(Math.PI-1.1)*(0.5+0.5*Math.sin(t*.5+q*2.4));
    }
    pts.rotation.y=t*.05;
    ring1.rotation.z=t*.1; ring2.rotation.z=-t*.08;
    for(var j=0;j<crys.length;j++){
      crys[j].rotation.x+=.004+j*.0004;
      crys[j].rotation.y+=.006;
      crys[j].position.y+=Math.sin(t*1.2+j)*.002;
    }
    root.rotation.y=scrollY*.00045+mx*.08;
    root.position.y=-Math.min(scrollY*.0012,3);
    camera.position.x+=(mx*1.2-camera.position.x)*.04;
    camera.position.y+=(-my*.8+.6-camera.position.y)*.04;
    camera.lookAt(0,0,0);
    renderer.render(scene,camera);
    requestAnimationFrame(tick);
  })();
  addEventListener('resize',function(){
    camera.aspect=innerWidth/innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(innerWidth,innerHeight,false);
    layout();
  });
})();

/* ================= UI LOGIC ================= */
(function(){
  /* navbar */
  var header=document.getElementById('navbar');
  addEventListener('scroll',function(){header.classList.toggle('scrolled',scrollY>30);});
  var burger=document.getElementById('burger');
  burger.addEventListener('click',function(){header.classList.toggle('open');});
  document.querySelectorAll('#navLinks a').forEach(function(a){
    a.addEventListener('click',function(){header.classList.remove('open');});
  });

  /* reveal on scroll */
  var io=new IntersectionObserver(function(es){
    es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target);}});
  },{threshold:.12});
  document.querySelectorAll('.reveal').forEach(function(el){io.observe(el);});

  /* tilt cards */
  document.querySelectorAll('[data-tilt]').forEach(function(el){
    el.addEventListener('mousemove',function(ev){
      var r=el.getBoundingClientRect();
      var px=(ev.clientX-r.left)/r.width-.5, py=(ev.clientY-r.top)/r.height-.5;
      el.style.setProperty('--mx',((px+.5)*100)+'%');
      el.style.setProperty('--my',((py+.5)*100)+'%');
      el.style.transform='perspective(950px) rotateY('+(px*8)+'deg) rotateX('+(py*-8)+'deg) translateY(-6px)';
    });
    el.addEventListener('mouseleave',function(){el.style.transform='';});
  });

  /* mockup tilt */
  var mock=document.getElementById('mock');
  if(mock){
    var sc=mock.closest('.scene3d');
    sc.addEventListener('mousemove',function(ev){
      var r=sc.getBoundingClientRect();
      var px=(ev.clientX-r.left)/r.width-.5, py=(ev.clientY-r.top)/r.height-.5;
      mock.style.transform='rotateY('+(px*10)+'deg) rotateX('+(py*-10)+'deg)';
    });
    sc.addEventListener('mouseleave',function(){mock.style.transform='';});
  }

  /* demo flashcard */
  var demo=document.getElementById('demoCard');
  demo.addEventListener('click',function(){demo.classList.toggle('flipped');});
  var nextEl=document.getElementById('nextReview');
  var map={hard:'مرور بعدی: ۱ روز دیگر ⏳',good:'مرور بعدی: ۳ روز دیگر 🌱',easy:'مرور بعدی: ۷ روز دیگر 🚀'};
  document.querySelectorAll('.rate').forEach(function(b){
    b.addEventListener('click',function(e){
      e.stopPropagation();
      nextEl.textContent=map[b.dataset.rate];
      nextEl.classList.remove('pop'); void nextEl.offsetWidth; nextEl.classList.add('pop');
    });
  });

  /* faq */
  document.querySelectorAll('.faq-item').forEach(function(item){
    var btn=item.querySelector('.faq-q');
    btn.addEventListener('click',function(){
      var wasOpen=item.classList.contains('open');
      document.querySelectorAll('.faq-item.open').forEach(function(o){
        o.classList.remove('open'); o.querySelector('.faq-a').style.maxHeight=null;
      });
      if(!wasOpen){
        item.classList.add('open');
        var a=item.querySelector('.faq-a');
        a.style.maxHeight=a.scrollHeight+'px';
      }
    });
  });

  /* waitlist form */
  var form=document.getElementById('wlForm');
  form.addEventListener('submit',function(e){
    e.preventDefault();
    var em=document.getElementById('email').value.trim();
    var ok=/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(em);
    var msg=document.getElementById('formMsg');
    if(!ok){
      msg.textContent='لطفاً یک ایمیل معتبر وارد کن.';
      form.classList.remove('shake'); void form.offsetWidth; form.classList.add('shake');
      return;
    }
    msg.textContent='';
    try{
      var key='vyrvona-waitlist';
      var list=JSON.parse(localStorage.getItem(key)||'[]');
      list.push({email:em,at:Date.now()});
      localStorage.setItem(key,JSON.stringify(list));
    }catch(_){}
    form.style.display='none';
    document.getElementById('wlSuccess').classList.add('show');
  });
})();
</script>
</body>
</html>
